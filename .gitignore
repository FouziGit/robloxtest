# Wally
Packages/
ServerPackages/
DevPackages/

# Build outputs
build/
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
# ...except the animation clips, which are generated art like the textures and the sounds, and committed
# for the same reason: CI has no Blender to regenerate them, and the tests read them.
!assets/animations/*.rbxmx
sourcemap.json

# luau-lsp Roblox type definitions (downloaded by scripts/setup.sh)
globalTypes.d.luau

# Texture generators (tools/textures). The PNGs in assets/ ARE committed -- they are the art, and
# committing them is what keeps CI from needing Python at all -- but the interpreter's cache is not.
__pycache__/
*.pyc

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Secrets. The Open Cloud API key used to upload assets (asphalt reads ASPHALT_API_KEY) lives here and
# nowhere else: it has write access to the account's assets, so it must never reach the repository.
.env
.env.*

# Third-party archives fetched by tools/thirdparty/fetch.py: large, and pinned by hash in sources.json.
.cache/
