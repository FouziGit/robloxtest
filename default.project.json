{
	"name": "Vellum",
	"globIgnorePaths": ["**/*.spec.luau"],
	"tree": {
		"$className": "DataModel",

		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Shared": {
				"$path": "src/shared"
			},
			"UI": {
				"$path": "src/ui"
			},
			"Packages": {
				"$path": "Packages"
			}
		},

		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"StreamingEnabled": false,
				"StreamingIntegrityMode": "PauseOutsideLoadedArea",
				"StreamingMinRadius": 64,
				"StreamingTargetRadius": 1024,
				"StreamOutBehavior": "LowMemory",
				"ModelStreamingBehavior": "Improved"
			}
		},

		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$path": "src/server"
		},

		"ServerStorage": {
			"$className": "ServerStorage"
		},

		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$properties": {
				"CharacterWalkSpeed": 16,
				"CharacterJumpPower": 50,
				"CharacterUseJumpPower": true,
				"EnableMouseLockOption": false
			},
			"StarterPlayerScripts": {
				"$path": "src/client"
			}
		},

		"StarterGui": {
			"$className": "StarterGui",
			"$properties": {
				"ScreenOrientation": "LandscapeSensor",
				"ResetPlayerGuiOnSpawn": false
			}
		}
	}
}
