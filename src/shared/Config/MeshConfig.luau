MeshConfig.Meshes = {} :: { [string]: Mesh }
for key, entry in pairs(MANIFEST) do
	local uploaded = UPLOADED[entry.Source]
	MeshConfig.Meshes[key] = {
		Key = key,
		Source = entry.Source,
		Tris = entry.Tris,
		Min = entry.Min,
		Max = entry.Max,
		Pivot = entry.Pivot,
		Reference = entry.Reference,
		Axis = entry.Axis,
		Flat = entry.Flat,
		Id = if uploaded ~= nil then uploaded.Id else "",
		Native = if uploaded ~= nil then uploaded.Native else nil,
	}
end

-- The mesh named `key`, or nil for a key no manifest entry has.
function MeshConfig.get(key: string): Mesh?
	return MeshConfig.Meshes[key]
end

return MeshConfig
