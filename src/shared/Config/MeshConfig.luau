--!strict
-- The generated volumes (D-114): what each mesh is, where its file is, and the id it renders with.
--
-- Every mesh is generated by tools/meshes/ (headless Blender, seeded, byte-reproducible), committed as a
-- glTF binary in assets/meshes/, uploaded through Open Cloud as a Model, and rendered by the client as
-- a SpecialMesh on a pooled part -- the one route a client script can set a mesh id through. Open Cloud
-- makes a Model, not a mesh: the id the SpecialMesh needs is the MeshPart's inside it, read once in
-- Studio and recorded by scripts/upload_assets.py (record-meshes).
--
-- Like AssetIds, an id here may be empty, and empty means "not uploaded or not resolved yet": the
-- renderer skips the layer, warns once naming the file, and nothing else stops.
--
-- Pure data: no require, no Roblox global.

export type Axis = "X" | "Y" | "Z"

-- What the generator measured (tools/meshes/generate_all.py writes the block below from
-- assets/meshes/manifest.json). Min and Max are the mesh's bounds in reference units, Roblox axes;
-- Pivot is the point the runtime places, in the same units -- the importer recentres a mesh on its
-- bounds, so the runtime offsets it back from these.
export type Entry = {
	Source: string,
	Tris: number,
	Min: { number },
	Max: { number },
	Pivot: { number },
	-- Which extent is exactly 1: a layer's Size is studs of THIS (an ensō by its outer ink, a drop by
	-- its length).
	Reference: string,
	-- The only axis the runtime turns it about (the lighting rule: its normals point up along it).
	Axis: Axis,
	Flat: boolean,
}

-- The id a SpecialMesh renders, and the size the importer gave the mesh (its MeshSize, studs), which
-- is what a Scale is a multiple of. Written by scripts/upload_assets.py after Studio resolved it.
export type Uploaded = { Id: string, Native: { number } }

export type Mesh = Entry & {
	Key: string,
	-- "rbxassetid://123", or "" while the mesh is not uploaded or not resolved.
	Id: string,
	-- The imported size in studs, nil until resolved.
	Native: { number }?,
}

