-- Looping music (tools/audio/music.py), seamless by construction. Switched by MatchController and
-- BossController, ducked by SoundController under a heavy impact.
SoundConfig.Music = {
	Hub = sound("music_hub.wav", 24.00, 0.22, 0.0),
	Match = sound("music_match.wav", 24.00, 0.24, 0.0),
	Boss = sound("music_boss.wav", 24.00, 0.3, 0.0),
} :: { [string]: SoundEntry }

-- The key a pigment's voice is stored under: "Cinnabar" .. "Impact" is CinnabarImpact.
function SoundConfig.voiceKey(pigment: string, voice: string): string
	return pigment .. voice
end

-- Every key, sfx then music, whose WAV still has to be uploaded, in a stable order. The client logs
-- this once at startup so the gap is visible in the output rather than discovered as a silent fight.
function SoundConfig.missing(): { string }
	local keys: { string } = {}
	for key, entry in pairs(SoundConfig.Sfx) do
		if entry.Id == "" then
			table.insert(keys, key)
		end
	end
	for key, entry in pairs(SoundConfig.Music) do
		if entry.Id == "" then
			table.insert(keys, "Music." .. key)
		end
	end
	table.sort(keys)
	return keys
end

return SoundConfig
